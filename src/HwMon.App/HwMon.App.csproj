<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Só pelo ícone da bandeja (NotifyIcon); os usings globais do Windows Forms ficam desligados abaixo. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Nodekeeper</AssemblyName>
    <RootNamespace>HwMon.App</RootNamespace>
    <Version>0.14.1</Version>
    <Product>Nodekeeper</Product>
    <ApplicationIcon>..\..\icons\app.ico</ApplicationIcon>
    <!-- Tema Fluent do WPF (Application.ThemeMode) ainda é marcado como experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Identidade visual (Nodekeeper): ícones em icons/, fonte em design/nodekeeper/fonts (ver design/nodekeeper/LEIA-ME.md). -->
  <ItemGroup>
    <Resource Include="..\..\icons\app.ico" Link="Assets\app.ico" />
    <Resource Include="..\..\icons\app\app-48.png" Link="Assets\app-48.png" />
    <!-- Manrope (SIL OFL 1.1) embutida: Font.Text / Font.Display em Theme/Styles.xaml. -->
    <Resource Include="..\..\design\nodekeeper\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HwMon.Client\HwMon.Client.csproj" />
  </ItemGroup>

</Project>
