<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nodekeeper · tema claro · gerado de design/nodekeeper/tokens.json (não editar à mão) -->

    <!-- Janela -->
    <SolidColorBrush x:Key="App.Background" Color="#F4F2FA"/>
    <SolidColorBrush x:Key="App.Sidebar" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="App.SidebarSelected" Color="#1F5B47D6"/>
    <SolidColorBrush x:Key="App.Divider" Color="#1A3C2878"/>

    <!-- Cartões -->
    <SolidColorBrush x:Key="Card.Background" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="Card.BackgroundHover" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="Card.Border" Color="#1F3C2878"/>
    <SolidColorBrush x:Key="Card.Inset" Color="#80FFFFFF"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="Text.Primary" Color="#1C1A22"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#5E5869"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#706A7B"/>

    <!-- Destaque -->
    <SolidColorBrush x:Key="Accent" Color="#5B47D6"/>
    <SolidColorBrush x:Key="Accent.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#ECE8FF"/>
    <SolidColorBrush x:Key="Accent.SoftText" Color="#3F2FA8"/>

    <!-- Etiquetas -->
    <SolidColorBrush x:Key="Badge.Background" Color="#145B47D6"/>
    <SolidColorBrush x:Key="Badge.Foreground" Color="#4B4558"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="Status.Ok" Color="#1F8A47"/>
    <SolidColorBrush x:Key="Status.Caution" Color="#B7791F"/>
    <SolidColorBrush x:Key="Status.CautionSoft" Color="#FCF1DC"/>
    <SolidColorBrush x:Key="Status.CautionText" Color="#7A4E0B"/>
    <SolidColorBrush x:Key="Status.Critical" Color="#D1242F"/>
    <SolidColorBrush x:Key="Status.CriticalSoft" Color="#FCE4E5"/>
    <SolidColorBrush x:Key="Status.CriticalText" Color="#A1161F"/>

    <!-- Barras -->
    <SolidColorBrush x:Key="Bar.Track" Color="#1F3C2878"/>

    <!-- Controles -->
    <SolidColorBrush x:Key="Button.Background" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="Button.Border" Color="#2E3C2878"/>
    <SolidColorBrush x:Key="Input.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Input.Border" Color="#2E3C2878"/>
    <SolidColorBrush x:Key="Dialog.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#6114181E"/>

    <!-- Widget -->
    <SolidColorBrush x:Key="Widget.Background" Color="#E0FBFCFD"/>
    <SolidColorBrush x:Key="Widget.Border" Color="#1A000000"/>
    <SolidColorBrush x:Key="Widget.BarTrack" Color="#14000000"/>
    <SolidColorBrush x:Key="Widget.Text.Secondary" Color="#5E5869"/>

    <!-- Fundo em gradiente: empilhe App.Background + App.Glow1..3 (ver LEIA-ME) -->
    <RadialGradientBrush x:Key="App.Glow1" Center="0.08,0" GradientOrigin="0.08,0" RadiusX="0.833" RadiusY="0.814"><GradientStop Color="#4D8C6EFF" Offset="0"/><GradientStop Color="#008C6EFF" Offset="0.6"/></RadialGradientBrush>  <!-- lavanda -->
    <RadialGradientBrush x:Key="App.Glow2" Center="1,1" GradientOrigin="1,1" RadiusX="0.682" RadiusY="0.814"><GradientStop Color="#52FF8CB9" Offset="0"/><GradientStop Color="#00FF8CB9" Offset="0.6"/></RadialGradientBrush>  <!-- rosa -->
    <RadialGradientBrush x:Key="App.Glow3" Center="0.75,0.04" GradientOrigin="0.75,0.04" RadiusX="0.606" RadiusY="0.698"><GradientStop Color="#3D78AAFF" Offset="0"/><GradientStop Color="#0078AAFF" Offset="0.6"/></RadialGradientBrush>  <!-- azul -->
</ResourceDictionary>
