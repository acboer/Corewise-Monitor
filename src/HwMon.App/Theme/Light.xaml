<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Corewise · tema claro · gerado de design/tokens.json (não editar à mão) -->

    <!-- Janela -->
    <SolidColorBrush x:Key="App.Background" Color="#F3F4F7"/>
    <SolidColorBrush x:Key="App.Sidebar" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="App.SidebarSelected" Color="#DCE1E8"/>
    <SolidColorBrush x:Key="App.Divider" Color="#D5DAE1"/>

    <!-- Cartões -->
    <SolidColorBrush x:Key="Card.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Card.BackgroundHover" Color="#F8F9FB"/>
    <SolidColorBrush x:Key="Card.Border" Color="#E1E5EA"/>
    <SolidColorBrush x:Key="Card.Inset" Color="#F5F6F9"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="Text.Primary" Color="#1D2127"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#5A636E"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#6E7783"/>

    <!-- Destaque -->
    <SolidColorBrush x:Key="Accent" Color="#0B7C8E"/>
    <SolidColorBrush x:Key="Accent.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#DDF3F6"/>
    <SolidColorBrush x:Key="Accent.SoftText" Color="#0B5C69"/>

    <!-- Etiquetas -->
    <SolidColorBrush x:Key="Badge.Background" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="Badge.Foreground" Color="#4A535E"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="Status.Ok" Color="#1F8A47"/>
    <SolidColorBrush x:Key="Status.Caution" Color="#B7791F"/>
    <SolidColorBrush x:Key="Status.CautionSoft" Color="#FCF1DC"/>
    <SolidColorBrush x:Key="Status.CautionText" Color="#7A4E0B"/>
    <SolidColorBrush x:Key="Status.Critical" Color="#D1242F"/>
    <SolidColorBrush x:Key="Status.CriticalSoft" Color="#FCE4E5"/>
    <SolidColorBrush x:Key="Status.CriticalText" Color="#A1161F"/>

    <!-- Barras -->
    <SolidColorBrush x:Key="Bar.Track" Color="#E1E5EA"/>

    <!-- Controles -->
    <SolidColorBrush x:Key="Button.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Button.Border" Color="#D3D9E0"/>
    <SolidColorBrush x:Key="Input.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Input.Border" Color="#D3D9E0"/>
    <SolidColorBrush x:Key="Dialog.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#6114181E"/>

    <!-- Widget -->
    <SolidColorBrush x:Key="Widget.Background" Color="#E0FBFCFD"/>
    <SolidColorBrush x:Key="Widget.Border" Color="#1A000000"/>
    <SolidColorBrush x:Key="Widget.BarTrack" Color="#14000000"/>
    <SolidColorBrush x:Key="Widget.Text.Secondary" Color="#5A636E"/>
</ResourceDictionary>
