<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nodekeeper · cor de destaque dos controles Fluent (tema Light). Os controles do WPF (caixa de seleção, opção,
         controle deslizante, foco das caixas de texto…) pintam com a cor de destaque do Windows; estes são os mesmos
         pincéis do tema Fluent do WPF (github.com/dotnet/wpf, licença MIT) com o violeta da identidade no lugar.
         Gerado de Resources/Theme/Light.xaml; App.ApplyAccent copia para o topo de Application.Resources. -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4936B3" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF36278A" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF5B47D6" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF7B66E8" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF5B47D6" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Opacity="0.9" Color="#FF5B47D6" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Opacity="0.8" Color="#FF5B47D6" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF7B66E8" />
    <LinearGradientBrush x:Key="TextControlElevationBorderFocusedBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
          <ScaleTransform ScaleY="-1" CenterY="0.5" />
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
          <GradientStop Offset="1.0" Color="#FF5B47D6" />
          <GradientStop Offset="1.0" Color="#0F000000" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF5B47D6" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF5B47D6" Opacity="0.9" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF5B47D6" Opacity="0.8" />
