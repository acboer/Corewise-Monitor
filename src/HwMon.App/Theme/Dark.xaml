<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nodekeeper · tema escuro · gerado de design/nodekeeper/tokens.json (não editar à mão) -->

    <!-- Janela -->
    <SolidColorBrush x:Key="App.Background" Color="#0E0C14"/>
    <SolidColorBrush x:Key="App.Sidebar" Color="#6B0C0916"/>
    <SolidColorBrush x:Key="App.SidebarSelected" Color="#29A08CFF"/>
    <SolidColorBrush x:Key="App.Divider" Color="#12FFFFFF"/>

    <!-- Cartões -->
    <SolidColorBrush x:Key="Card.Background" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="Card.BackgroundHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Card.Border" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Card.Inset" Color="#4708060E"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="Text.Primary" Color="#ECE9F2"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#A39DB0"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8A8497"/>

    <!-- Destaque -->
    <SolidColorBrush x:Key="Accent" Color="#A08CFF"/>
    <SolidColorBrush x:Key="Accent.Foreground" Color="#160F33"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#2A2347"/>
    <SolidColorBrush x:Key="Accent.SoftText" Color="#CFC5FF"/>

    <!-- Etiquetas -->
    <SolidColorBrush x:Key="Badge.Background" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Badge.Foreground" Color="#C2BBCF"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="Status.Ok" Color="#3CCB7F"/>
    <SolidColorBrush x:Key="Status.Caution" Color="#F5B13D"/>
    <SolidColorBrush x:Key="Status.CautionSoft" Color="#3A2D12"/>
    <SolidColorBrush x:Key="Status.CautionText" Color="#F7CD7E"/>
    <SolidColorBrush x:Key="Status.Critical" Color="#F2555A"/>
    <SolidColorBrush x:Key="Status.CriticalSoft" Color="#3A1A1D"/>
    <SolidColorBrush x:Key="Status.CriticalText" Color="#F7A3A6"/>

    <!-- Barras -->
    <SolidColorBrush x:Key="Bar.Track" Color="#17FFFFFF"/>

    <!-- Controles -->
    <SolidColorBrush x:Key="Button.Background" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Button.Border" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Input.Background" Color="#15131B"/>
    <SolidColorBrush x:Key="Input.Border" Color="#343041"/>
    <SolidColorBrush x:Key="Dialog.Background" Color="#1E1B26"/>
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#9E05070A"/>

    <!-- Widget -->
    <SolidColorBrush x:Key="Widget.Background" Color="#DB1B1922"/>
    <SolidColorBrush x:Key="Widget.Border" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Widget.BarTrack" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Widget.Text.Secondary" Color="#ADA7BA"/>

    <!-- Fundo em gradiente: empilhe App.Background + App.Glow1..3 (ver LEIA-ME) -->
    <RadialGradientBrush x:Key="App.Glow1" Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.833" RadiusY="0.814"><GradientStop Color="#577C5CFF" Offset="0"/><GradientStop Color="#007C5CFF" Offset="0.6"/></RadialGradientBrush>  <!-- violeta -->
    <RadialGradientBrush x:Key="App.Glow2" Center="1,1" GradientOrigin="1,1" RadiusX="0.682" RadiusY="0.814"><GradientStop Color="#38D64C8C" Offset="0"/><GradientStop Color="#00D64C8C" Offset="0.6"/></RadialGradientBrush>  <!-- magenta -->
    <RadialGradientBrush x:Key="App.Glow3" Center="0.72,0.06" GradientOrigin="0.72,0.06" RadiusX="0.606" RadiusY="0.698"><GradientStop Color="#2E3C5ADC" Offset="0"/><GradientStop Color="#003C5ADC" Offset="0.6"/></RadialGradientBrush>  <!-- indigo -->
</ResourceDictionary>
