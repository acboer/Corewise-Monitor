<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nodekeeper · cor de destaque dos controles Fluent (tema Dark). Os controles do WPF (caixa de seleção, opção,
         controle deslizante, foco das caixas de texto…) pintam com a cor de destaque do Windows; estes são os mesmos
         pincéis do tema Fluent do WPF (github.com/dotnet/wpf, licença MIT) com o violeta da identidade no lugar.
         Gerado de Resources/Theme/Dark.xaml; App.ApplyAccent copia para o topo de Application.Resources. -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFC2B5FF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFC2B5FF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF7B66E8" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Opacity="0.9" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Opacity="0.8" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF7B66E8" />
    <LinearGradientBrush x:Key="TextControlElevationBorderFocusedBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
          <ScaleTransform ScaleY="-1" CenterY="0.5" />
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
          <GradientStop Offset="1.0" Color="#FFA08CFF" />
          <GradientStop Offset="1.0" Color="#12FFFFFF" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFA08CFF" Opacity="0.9" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFA08CFF" Opacity="0.8" />
    <SolidColorBrush x:Key="CalendarViewSelectedBackground" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="#FFA08CFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#FFA08CFF" />
