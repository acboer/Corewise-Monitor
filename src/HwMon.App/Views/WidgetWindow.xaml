<Window x:Class="HwMon.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HwMon.App.ViewModels"
        xmlns:controls="clr-namespace:HwMon.App.Controls"
        Title="Corewise · widget" Width="270" SizeToContent="Height" Icon="/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="{Binding Topmost}"
        FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Text.Primary}">

    <Grid Margin="8">
    <!-- Fundo separado do conteúdo: a transparência só afeta o fundo, o texto continua legível. -->
    <Border Background="{DynamicResource Widget.Background}" BorderBrush="{DynamicResource Widget.Border}" BorderThickness="1"
            CornerRadius="14" Opacity="{Binding BackgroundOpacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
    </Border>
    <Border Background="#01000000" CornerRadius="14" Padding="13,9,9,13" MouseLeftButtonDown="Drag">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Abrir painel" Click="OpenPanel_Click"/>
                <MenuItem Header="Escolher métricas..." Click="Configure_Click"/>
                <MenuItem Header="Sempre no topo" IsCheckable="True" IsChecked="{Binding Topmost}"/>
                <MenuItem Header="Estilo">
                    <MenuItem Header="Compacto" IsCheckable="True" IsChecked="{Binding IsCompact}"/>
                    <MenuItem Header="Visual (com ícones)" IsCheckable="True" IsChecked="{Binding IsVisual}"/>
                </MenuItem>
                <MenuItem Header="Mostrar tempo de carga" IsCheckable="True" IsChecked="{Binding ShowChargeTime}"/>
                <MenuItem Header="Transparência do fundo">
                    <MenuItem Header="Sólido" Command="{Binding SetTransparencyCommand}" CommandParameter="0"/>
                    <MenuItem Header="20 %" Command="{Binding SetTransparencyCommand}" CommandParameter="20"/>
                    <MenuItem Header="40 %" Command="{Binding SetTransparencyCommand}" CommandParameter="40"/>
                    <MenuItem Header="60 %" Command="{Binding SetTransparencyCommand}" CommandParameter="60"/>
                    <MenuItem Header="80 %" Command="{Binding SetTransparencyCommand}" CommandParameter="80"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Fechar widget" Click="Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <!-- Cabeçalho: máquina atual, setas para trocar, fixar, configurar, fechar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Current.Status, Converter={StaticResource StatusToBrush}}"/>
                <TextBlock Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Current.Name, Mode=OneWay}"/>
                </TextBlock>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="action-previous" Command="{Binding PreviousCommand}" ToolTip="Máquina anterior"
                        Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVisibility}}"/>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="action-next" Command="{Binding NextCommand}" ToolTip="Próxima máquina"
                        Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVisibility}}"/>
                <Button Grid.Column="4" Command="{Binding TogglePinCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Tag" Value="action-unpin"/>
                            <Setter Property="ToolTip" Value="Fixar sempre no topo"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Topmost}" Value="True">
                                    <Setter Property="Tag" Value="action-pin"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <Setter Property="ToolTip" Value="Sempre no topo (clique para soltar)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource IconButton}" Tag="action-metrics" Click="Configure_Click" ToolTip="Escolher métricas"/>
                <Button Grid.Column="6" Style="{StaticResource IconButton}" Tag="action-close" Click="Close_Click" ToolTip="Fechar widget"/>
            </Grid>
            <TextBlock Text="{Binding Current.AgeText}" Style="{StaticResource Caption}" FontSize="11" Margin="16,0,0,6"/>

            <TextBlock Text="Nenhuma máquina pareada. Abra o painel para adicionar." TextWrapping="Wrap" Margin="0,4,4,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Current}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Blocos por categoria (CPU, Memória, GPU, Armazenamento, Rede, Periféricos), com espaço entre eles.
                 Estilo compacto: título pequeno em texto. Estilo visual: ícone da categoria e valores maiores. -->
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WidgetGroup}">
                        <StackPanel x:Name="Block" Margin="0,8,0,4">
                            <!-- Cabeçalho do bloco -->
                            <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,0,0,2" TextElement.Foreground="{DynamicResource Widget.Text.Secondary}">
                                <Border x:Name="Chip" Style="{StaticResource IconChip}" Width="20" Height="20" CornerRadius="6" Margin="0,0,7,0" Visibility="Collapsed">
                                    <controls:Icon Kind="{Binding Icon}" Width="13" Height="13"/>
                                </Border>
                                <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource Text.Base}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WidgetRow}">
                                        <StackPanel Margin="0,3,0,0" Opacity="{Binding IsStale, Converter={StaticResource StaleToOpacity}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Base}" FontSize="12" Foreground="{DynamicResource Widget.Text.Secondary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Val" Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Base}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=Text}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" Margin="0,1,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}"/>
                                            <controls:FractionBar x:Name="Bar" Height="4" Margin="0,3,0,0" Fraction="{Binding Fraction, Converter={StaticResource NullableDouble}}"
                                                                  Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Track="{DynamicResource Widget.BarTrack}"
                                                                  Visibility="{Binding Fraction, Converter={StaticResource NullToVisibility}}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsVisual, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="Val" Property="FontSize" Value="15"/>
                                                <Setter TargetName="Bar" Property="Height" Value="5"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsVisual, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Chip" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Title" Property="FontSize" Value="12"/>
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                <Setter TargetName="Header" Property="Margin" Value="0,0,0,4"/>
                                <Setter TargetName="Block" Property="Margin" Value="0,10,0,6"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
    </Grid>
</Window>
