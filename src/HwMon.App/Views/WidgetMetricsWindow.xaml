<Window x:Class="HwMon.App.Views.WidgetMetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HwMon.App.ViewModels"
        Title="Métricas do widget" Width="420" Height="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Dialog.Background}" FontFamily="{StaticResource Font.Text}" Icon="/Assets/app.ico"
        Foreground="{DynamicResource Text.Primary}" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" Style="{StaticResource Text.DialogTitle}"/>
            <TextBlock Text="Escolha o que aparece no widget para esta máquina. O painel tem a sua própria escolha." TextWrapping="Wrap"
                       Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Restaurar padrão" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="Default_Click"/>
            <Button Content="Cancelar" Style="{StaticResource FlatButton}" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Salvar" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        <Border Background="{DynamicResource Card.Inset}" BorderBrush="{DynamicResource Card.Border}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,6">
                <ItemsControl x:Name="List">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetricOption}">
                            <CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" Margin="8,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
