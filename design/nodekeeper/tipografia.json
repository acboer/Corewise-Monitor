{
  "family": {
    "primary": "Manrope",
    "fallback": ["Segoe UI Variable Text", "Segoe UI"],
    "mono": ["Cascadia Mono", "Consolas"],
    "license": "SIL Open Font License 1.1 — pode ser embutida no aplicativo",
    "source": "https://fonts.google.com/specimen/Manrope (variável, pesos 200–800)",
    "numerals": "tabular (Typography.NumeralAlignment=Tabular) em todos os valores medidos"
  },
  "unit": "px (= DIP no WPF)",
  "scale": {
    "Page.Title":        { "size": 26, "weight": 700, "lineHeight": 32, "letterSpacing": -0.015 },
    "Page.Subtitle":     { "size": 13, "weight": 500, "lineHeight": 18, "color": "Text.Secondary" },
    "Dialog.Title":      { "size": 18, "weight": 700, "lineHeight": 24 },
    "MachineCard.Title": { "size": 16, "weight": 700, "lineHeight": 22 },
    "Card.Title":        { "size": 13, "weight": 700, "lineHeight": 18 },
    "Card.Subtitle":     { "size": 11.5, "weight": 500, "lineHeight": 16, "color": "Text.Secondary" },
    "Value.Main":        { "size": 28, "weight": 700, "lineHeight": 31, "letterSpacing": -0.02 },
    "Value.Unit":        { "size": 15, "weight": 500, "lineHeight": 20, "color": "Text.Secondary" },
    "Value.Caption":     { "size": 12.5, "weight": 500, "lineHeight": 18, "color": "Text.Secondary" },
    "Label":             { "size": 12.5, "weight": 500, "lineHeight": 18 },
    "Label.Small":       { "size": 12, "weight": 600, "lineHeight": 16 },
    "Caption":           { "size": 11, "weight": 500, "lineHeight": 14, "color": "Text.Tertiary" },
    "Section.Label":     { "size": 11, "weight": 700, "lineHeight": 14, "letterSpacing": 0.06, "textCase": "upper", "color": "Text.Tertiary" },
    "Nav.Item":          { "size": 13.5, "weight": 600, "lineHeight": 18 },
    "Button":            { "size": 13, "weight": 600, "lineHeight": 18 },
    "Widget.Name":       { "size": 13, "weight": 700, "lineHeight": 18 },
    "Widget.Label":      { "size": 12, "weight": 500, "lineHeight": 16, "color": "Widget.Text.Secondary" },
    "Widget.Value":      { "size": 13, "weight": 700, "lineHeight": 18 },
    "Wordmark":          { "size": 17, "weight": 700, "letterSpacing": -0.035, "textCase": "lower", "use": "\"nodekeeper\" na barra lateral; no logo, 24 px" }
  },
  "layout": {
    "sidebarWidth": 236,
    "contentPadding": [22, 28, 28, 28],
    "grid": { "minColumn": 232, "gap": 12, "rowMin": 222, "flow": "dense", "wideSpan": 2 },
    "card": { "radius": 18, "padding": 14, "border": 1 },
    "machineCard": { "minWidth": 440, "radius": 20, "padding": 18 },
    "widget": { "width": 270, "radius": 14 },
    "bar": { "height": 4, "radius": 2 },
    "sparkline": { "height": 32, "heightWide": 76, "stroke": 1.5, "fillOpacity": 0.12 }
  }
}
